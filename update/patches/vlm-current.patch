+    for(const el of nodes){
+      const t=(el.innerText||el.textContent||"").slice(0,3500);
+      if(!isPanelText(t))continue;
+      const r=el.getBoundingClientRect();
+      if(r.width<180||r.height<120)continue;
+      if(r.width>innerWidth*0.98&&r.height>innerHeight*0.98)continue;
+      list.push({el,area:r.width*r.height});
